# Public client configuration. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Firebase web client (project scrapo-613a1)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=scrapo-613a1.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=scrapo-613a1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=scrapo-613a1.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin service account JSON (single line).
# Required to verify ID tokens and write Trust & Safety data authoritatively.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"scrapo-613a1",...}
# Or point to a credentials file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Server-only. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Server-only Gemini Developer API key used by Firebase AI Logic.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
